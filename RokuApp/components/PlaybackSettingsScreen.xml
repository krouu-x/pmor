<?xml version="1.0" encoding="utf-8" ?>
<component name="PlaybackSettingsScreen" extends="Group">
    <interface>
        <field id="target" type="assocarray" onChange="onTarget" />
        <field id="request" type="assocarray" />
        <function name="focusMe" />
    </interface>
    <children>
        <!-- Semi-transparent background -->
        <Rectangle color="#80000000" width="1920" height="1080" />

        <!-- Settings panel -->
        <Group translation="[480, 180]" width="960" height="720">
            <Rectangle color="#1A1A2E" width="960" height="720" />
            <Rectangle color="#3A3A5E" width="960" height="4" translation="[0, 80]" />

            <!-- Title -->
            <Label id="titleLabel" translation="[40, 20]" width="880" height="50" font="font:LargeBoldSystemFont" color="#FFFFFF" text="Playback Settings" />

            <!-- Audio section -->
            <Label translation="[40, 100]" width="880" height="40" font="font:MediumBoldSystemFont" color="#00E5FF" text="Audio Track" />
            <RowList id="audioList" translation="[40, 140]" width="880" height="200" itemComponentName="OptionItem" itemSize="[880, 50]" numRows="4" drawFocusFeedback="true" focusable="true" />

            <!-- Subtitle section -->
            <Label translation="[40, 360]" width="880" height="40" font="font:MediumBoldSystemFont" color="#00E5FF" text="Subtitle Track" />
            <RowList id="subtitleList" translation="[40, 400]" width="880" height="200" itemComponentName="OptionItem" itemSize="[880, 50]" numRows="4" drawFocusFeedback="true" focusable="true" />

            <!-- Buttons -->
            <Group translation="[40, 620]" width="880" height="60" layoutDirection="horizontal">
                <Button id="applyBtn" width="200" height="50" text="Apply" focusable="true" />
                <Button id="cancelBtn" width="200" height="50" text="Cancel" translation="[220, 0]" focusable="true" />
            </Group>
        </Group>
    </children>
    <script type="text/brightscript" uri="pkg:/components/PlaybackSettingsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/navigation.brs" />
</component>